{
  "extends": "../../tsconfig.base.json",
  // The catalogue tests load the app's catalogues (apps/mobile), which Metro bundles as modules; resolve imports the
  // same way. The package source itself stays plain Node-runnable TypeScript (explicit .ts imports, erasable syntax).
  "compilerOptions": { "module": "Preserve", "moduleResolution": "Bundler" },
  "include": ["src", "*.test.ts"]
}
