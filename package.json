{
  "name": "hifz-amanah",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/api",
    "apps/mobile",
    "packages/contracts",
    "packages/domain"
  ],
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -p apps/api --noEmit && tsc -p packages/contracts --noEmit && tsc -p packages/domain --noEmit && tsc -p apps/mobile --noEmit",
    "api:dev": "npm run dev -w @hifz/api",
    "api:e2e-server": "npm run e2e-server -w @hifz/api",
    "db:migrate": "npm run migrate -w @hifz/api",
    "quran:source": "npm run quran:source -w @hifz/api --",
    "quran:convert": "npm run quran:convert -w @hifz/api --",
    "docs:check": "node scripts/check-traceability.mjs",
    "e2e:trace": "node e2e/scripts/traceability.mjs",
    "e2e:gate": "node e2e/scripts/spec-gate.mjs",
    "e2e:api": "playwright test -c e2e/api/playwright.config.ts",
    "e2e:mobile": "maestro test e2e/mobile"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.0",
    "fast-check": "^4.10.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
